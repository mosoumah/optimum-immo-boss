# Supabase Configuration Example — Optimum Immo
# Variables lues par le client (src/integrations/supabase/client.ts) : préfixe VITE_ obligatoire.
# Ne jamais préfixer une clé secrète (privileges eleves) par VITE_ : elle finirait dans le bundle navigateur.

VITE_SUPABASE_URL=https://<your-supabase-url>
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
